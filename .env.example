# AWS
AWS_REGION=ap-south-1
STACK_NAME=heatshift

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Telegram (store actual values in SSM, not here)
TELEGRAM_TOKEN_SSM_KEY=/heatshift/telegram-token
TELEGRAM_SECRET_SSM_KEY=/heatshift/telegram-secret

# Feature flags
ENABLE_SMS=false

# Frontend
NEXT_PUBLIC_API_URL=https://YOUR_API_ID.execute-api.ap-south-1.amazonaws.com/prod
NEXT_PUBLIC_WS_URL=wss://YOUR_WS_API_ID.execute-api.ap-south-1.amazonaws.com/prod

# Budget
BUDGET_EMAIL=your-email@example.com

# S3
FRONTEND_BUCKET=heatshift-frontend
